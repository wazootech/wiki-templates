{
  "name": "wiki-templates",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --check --no-script",
    "lint": "oxlint --deny-warnings",
    "check": "bun check --no-script",
    "check:deps": "bun scripts/check-template-deps.ts",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run check:deps"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/prismjs": "1.26.5",
    "@wazoo/wiki": "npm:@jsr/wazoo__wiki@0.7.0",
    "oxlint": "1.95.0",
    "prismjs": "1.30.0"
  }
}
