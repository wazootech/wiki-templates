{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "wiki *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "agent": {
    "wiki-reviewer": {
      "description": "Reviews wiki pages for quality standards, frontmatter, and style",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
